# Application
APP_ENV=development

# HTTP Server
HTTP_PORT=8080

# Database
DATABASE_URL=postgres://enduro:enduro_secret@localhost:5432/enduro_db?sslmode=disable

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars-long
JWT_ACCESS_TTL=15m

# Logging
LOG_LEVEL=info

# Graceful Shutdown
SHUTDOWN_TIMEOUT=30s
